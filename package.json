{
  "name": "lexi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "node e2e/run-all.mjs",
    "verify:rls": "node e2e/verify-rls.mjs",
    "verify:email": "node e2e/verify-email-setup.mjs",
    "test:unit": "vitest run",
    "dict:ja": "node scripts/fetch-lindera-dicts.mjs ja",
    "dict:zh": "node scripts/fetch-lindera-dicts.mjs zh",
    "dict:all": "node scripts/fetch-lindera-dicts.mjs",
    "deploy": "npm run dict:ja && npm run build && sudo rm -rf /var/www/lexi/* && sudo cp -r dist/* /var/www/lexi/ && sudo chown -R www-data:www-data /var/www/lexi && echo '배포 완료 — 브라우저에서 새로고침 (서비스워커 때문에 한 번 더 필요할 수 있음)'",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run verify:rls",
    "db:push": "supabase db push",
    "db:status": "supabase migration list"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "lindera-wasm-bundler": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.81.0",
    "supabase": "^2.119.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
